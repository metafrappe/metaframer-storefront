PORT=4301
HOST=127.0.0.1
# Empty means no proxy trust. For a local nginx proxy: 127.0.0.1,::1
# Accepts explicit IPs only. Bind the app privately; nginx must replace forwarded headers.
TRUSTED_PROXY_IPS=
# Server-to-server URL; not a VITE_ variable.
ADMIN_API_URL=http://localhost:4300
CATALOG_SHARED_SECRET=
# Public navigation URL, contains no secret.
VITE_ADMIN_URL=http://localhost:4300

# GitHub Pages builds use these public settings in pages.yml. No secrets here.
VITE_BASE_PATH=/
VITE_ROUTER_MODE=browser
VITE_API_BASE_URL=
